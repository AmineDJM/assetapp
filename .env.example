# ---------------------------------------------------------------------------
# Supabase — requis
# Project Settings > API dans le dashboard Supabase.
# ---------------------------------------------------------------------------
# Exposée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clé publique (anon / publishable). Exposée au navigateur, protégée par RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role : SERVEUR UNIQUEMENT. Utilisée seulement par le cron de
# rappels qui doit lire les obligations de tous les utilisateurs.
# Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cron — requis pour les rappels automatiques
# Chaîne aléatoire longue : `openssl rand -base64 32`
# Vercel l'envoie automatiquement en `Authorization: Bearer <CRON_SECRET>`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Notifications push (Web Push / VAPID) — optionnel
# Générer UNE SEULE FOIS : `npm run generate:vapid`
# Ne jamais régénérer après le premier déploiement (les abonnements existants
# deviendraient invalides).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Rappels email (Resend) — optionnel
# Si RESEND_API_KEY est absent, l'application fonctionne normalement :
# les rappels email sont simplement ignorés.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Patrimoine <patrimoine@example.com>
